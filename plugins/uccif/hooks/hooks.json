{
  "description": "UCCIF core hooks. Every handler logs one line and exits 0; none of them blocks.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "session-start"], "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "user-prompt-submit"], "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "pre-tool-use"], "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "post-tool-use"], "timeout": 5 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash|Grep|Glob", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "post-tool-use-failure"], "timeout": 5 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "subagent-start"], "timeout": 5 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "subagent-stop"], "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "stop"], "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "pre-compact"], "timeout": 10 } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "post-compact"], "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "session-end"], "timeout": 10 } ] }
    ],
    "InstructionsLoaded": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/uccif", "args": ["hook", "instructions-loaded"], "timeout": 5 } ] }
    ]
  }
}
