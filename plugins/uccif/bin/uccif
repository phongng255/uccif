#!/bin/sh
# UCCIF launcher: finds a Python 3.8+ interpreter and runs scripts/uccif_main.py.
# Tries python3 -> python -> py -3. Never fails a hook: on error, exits 0 when
# called as `uccif hook ...`, exits 127 otherwise. No PYTHONPATH (see uccif_main.py).
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
main="$(dirname -- "$here")/scripts/uccif_main.py"

is_hook=0
[ "$1" = "hook" ] && is_hook=1

for cand in python3 python "py -3"; do
  # shellcheck disable=SC2086
  if $cand -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    exec $cand "$main" "$@"
  fi
done

echo "uccif: no Python 3.8+ found (tried python3, python, py -3)" >&2
[ "$is_hook" = 1 ] && exit 0
exit 127
